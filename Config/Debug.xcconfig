#include "Base.xcconfig"

SWIFT_ACTIVE_COMPILATION_CONDITIONS = DEBUG
ONLY_ACTIVE_ARCH = YES

// Public defaults keep contributor builds ad-hoc signed and isolated from the
// production container. Personal signing values belong in Local.xcconfig.
MURALUME_DEBUG_CODE_SIGN_STYLE = Manual
MURALUME_DEBUG_CODE_SIGN_IDENTITY = -
MURALUME_DEBUG_DEVELOPMENT_TEAM =
MURALUME_DEBUG_PROVISIONING_PROFILE_SPECIFIER =

#include? "Local.xcconfig"

MURALUME_APP_BUNDLE_IDENTIFIER = com.muralume.Muralume.debug
CODE_SIGN_STYLE = $(MURALUME_DEBUG_CODE_SIGN_STYLE)
CODE_SIGN_IDENTITY = $(MURALUME_DEBUG_CODE_SIGN_IDENTITY)
DEVELOPMENT_TEAM = $(MURALUME_DEBUG_DEVELOPMENT_TEAM)
PROVISIONING_PROFILE_SPECIFIER = $(MURALUME_DEBUG_PROVISIONING_PROFILE_SPECIFIER)
