#include "Base.xcconfig"

SWIFT_COMPILATION_MODE = wholemodule
SWIFT_OPTIMIZATION_LEVEL = -O
DEAD_CODE_STRIPPING = YES

// A direct Xcode Release build is local-only. The formal distribution script
// overrides the bundle ID, disables Xcode signing, and applies Developer ID
// signing itself. Mac App Store archives use the separate AppStore config and
// Muralume-AppStore scheme; never repurpose this local configuration.
MURALUME_APP_BUNDLE_IDENTIFIER = com.muralume.Muralume.local
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =
PROVISIONING_PROFILE_SPECIFIER =
